# ==============================================
# Environment Configuration Template
# Copy to .env and adjust values for local development
# ==============================================

# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=3000
API_PREFIX=api

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tenant_project_tracker

# Frontend Web Application Configuration
VITE_API_URL=http://localhost:3000/api


# --- Security configuration -------------------------------------------------
# REQUIRED. The API refuses to start without a strong secret (>= 32 chars, not a placeholder).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value per environment and never commit the real one.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Browser origins allowed to call the API (comma-separated, exact match, no wildcard).
# Unset: http://localhost:5173 outside production, no cross-origin access in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limit for POST /auth/login and POST /auth/register, per client IP (defaults shown).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Set to 1 when the API runs behind a reverse proxy (Render, Railway, ...) so the rate limit
# uses each client's real IP. Leave unset when the API is reachable directly.
# TRUST_PROXY=1
