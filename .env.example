# ==============================================
# Environment Configuration Template
# Copy to .env and adjust values for local development
# ==============================================

# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=3000
API_PREFIX=api

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tenant_project_tracker

# Frontend Web Application Configuration
VITE_API_URL=http://localhost:3000/api

# First PLATFORM_ADMIN bootstrap, read only by `npm run seed`. Leave empty to skip; never commit real values.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
